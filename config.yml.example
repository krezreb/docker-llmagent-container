# ~/.config/dev-agent/config.yml
#
# The image to run when neither --image nor DEV_AGENT_IMAGE names one. A bare
# variant name such as "full" means dev-agent:full.
# default_image: dev-agent:ubuntu26

# Options applied before the command line's, which can override them
# (--no-proxy undoes --proxy, --no-dind undoes --dind, --no-gpu undoes --gpu).
# default_flags: --proxy

# Extra host paths to expose inside the container, one per line, as
#   - source:destination[:ro]
# "~" is expanded. The source must already exist.
mounts:
  # - ~/.gitconfig:/home/agent/.gitconfig:ro
  # - ~/.ssh:/home/agent/.ssh:ro
  # - ~/src/shared-lib:/shared:ro
  # tmux users can share their host's conf with container
  # - ~/.tmux.conf:/home/agent/.tmux.conf:ro
  # same for vim conf
  # - ~/.vimrc:/home/agent/.vimrc:ro

# Host environment variables to pass into the container by name, when set in
# the shell that runs dev-agent. A '*' matches any characters, so AWS_*
# passes every AWS_ variable. Anything passed is readable by the agent.
env:
  # - GH_TOKEN
  # - AWS_*
  # - AWS_PROFILE

# A host script run before every launch. Each KEY=VALUE line it prints is added
# to the container's environment; a non-zero exit stops the launch. It is run
# with DEV_AGENT_PROJECT and DEV_AGENT_COMMAND set, for per-project choices.
# See env.sh.example in the dev-agent repository.
# env_script: ~/.config/dev-agent/env.sh
