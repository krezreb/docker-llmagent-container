# ~/.config/dev-agent/config.yml
#
# Extra host paths to expose inside the container, one per line, as
#   - source:destination[:ro]
# "~" is expanded. The source must already exist.
mounts:
  # - ~/.gitconfig:/home/agent/.gitconfig:ro
  # - ~/.ssh:/home/agent/.ssh:ro
  # - ~/src/shared-lib:/shared:ro
  # tmux users can share their host's conf with container
  # - ~/.tmux.conf:/home/agent/.tmux.conf:ro
  # same for vim conf
  # - ~/.vimrc:/home/agent/.vimrc:ro
