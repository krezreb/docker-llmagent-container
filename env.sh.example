#!/bin/sh
# Copy to ~/.config/dev-agent/env.sh, chmod +x, and set
#   env_script: ~/.config/dev-agent/env.sh
# in ~/.config/dev-agent/config.yml.
#
# Runs on the host before every dev-agent launch. Every KEY=VALUE line printed
# on stdout ends up in the container's environment; stderr goes to your
# terminal. Exit non-zero to stop the launch.
#
# DEV_AGENT_PROJECT is the project directory and DEV_AGENT_COMMAND the command
# (claude, codex, bash or tmux), for choosing credentials per project.
set -e

# GitHub CLI token, for gh and for git over HTTPS through gh's credential helper.
echo "GH_TOKEN=$(gh auth token)"

# Short-lived AWS credentials from your current profile (SSO, assume-role, ...),
# printed as AWS_ACCESS_KEY_ID=..., AWS_SECRET_ACCESS_KEY=..., AWS_SESSION_TOKEN=...
# case "$DEV_AGENT_PROJECT" in
#     */work/*) export AWS_PROFILE=work ;;
#     *)        export AWS_PROFILE=personal ;;
# esac
# aws configure export-credentials --format env-no-export
