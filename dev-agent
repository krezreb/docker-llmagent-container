#!/usr/bin/env bash
set -euo pipefail

config="${DEV_AGENT_CONFIG:-$HOME/.config/dev-agent/config.yml}"

# The image: --image, else DEV_AGENT_IMAGE, else 'default_image:' from the
# config file, else the base. A bare name in the config file or the flag is
# one of ours: 'full' means dev-agent:full.
default_image=""

if [[ -f "$config" ]]; then
    default_image=$(awk '
        /^default_image:/ {
            sub(/^default_image:[[:space:]]*/, "")
            sub(/[[:space:]]*(#.*)?$/, "")
            gsub(/^["\047]|["\047]$/, "")
            print
            exit
        }
    ' "$config")
fi

if [[ -n "$default_image" && "$default_image" != *[:/]* ]]; then
    default_image="dev-agent:$default_image"
fi

IMAGE="${DEV_AGENT_IMAGE:-${default_image:-dev-agent:ubuntu26}}"

usage() {
    cat >&2 <<'EOF'
Usage:
    dev-agent [options] [codex|claude|bash|tmux] [directory] [agent arguments...]

The command defaults to 'bash' and the directory to the current one.

The project is mounted at the path it has on this host, and the agent starts
there, so every path it prints is a path you can use out here too.

Options:
    --ro        Mount the project read-only, for investigating code without
                changing it.
    --workspace Mount at /workspace instead, the way this wrapper used to.
                DEV_AGENT_MIRROR=0 makes that the default.
    --mirror    Mount at the host path, undoing DEV_AGENT_MIRROR=0.
    --host-network
                Share the host's network namespace, for a login flow whose
                callback URL points at localhost. Drops the container's
                network isolation, and the prompt then shows the host's
                hostname instead of the image's. Not with --proxy.
    --proxy     Route all network access through the dev-agent proxy and cut
                off direct internet access. Starts the proxy if it is not
                already running; its web UI is at http://127.0.0.1:8099.
                Log in once with --host-network first: the OAuth callback
                cannot reach a container on an internal network.
    --image NAME
                Run this image instead of $DEV_AGENT_IMAGE, 'default_image:'
                in config.yml, or dev-agent:ubuntu26. A bare variant name
                such as 'full' means dev-agent:full.

Options may be given before the command or before the directory; everything
from the directory on goes to the agent.

Examples:
    dev-agent
    dev-agent codex .
    dev-agent claude .
    dev-agent codex ~/src/foo
    dev-agent claude ~/src/foo --model opus
    dev-agent bash ~/src/foo
    dev-agent tmux ~/src/foo
    dev-agent --ro claude ~/src/foo
    dev-agent claude --ro ~/src/foo
    dev-agent --workspace claude ~/src/foo
    dev-agent --host-network codex ~/src/foo
    dev-agent --proxy claude ~/src/foo
    dev-agent --image full claude ~/src/foo
EOF
    exit 2
}

die() {
    printf 'dev-agent: %s\n' "$*" >&2
    exit 1
}

#
# Wrapper options are accepted before the command and between the command and
# the directory. From the directory onwards every argument belongs to the
# agent, so an agent of its own can still be given a '--ro' flag.
#
ro=""

# Host network namespace, needed by auth flows that listen on localhost for a
# callback. Off by default: it removes the container's network isolation.
host_net=""

# Route egress through the dev-agent proxy, on a docker network with no route
# to the internet. Off by default: it needs the proxy installed, and it breaks
# anything that is not HTTP or HTTPS.
proxy=""

# The project is mirrored at its host path unless that is turned off, either
# for one run with --workspace or for good with DEV_AGENT_MIRROR=0.
mirror="${DEV_AGENT_MIRROR:-1}"

case "$mirror" in
    0|no|off|false) mirror="" ;;
esac

# Mirroring that was merely inherited gives way to /workspace when a path
# cannot be mirrored; mirroring that was asked for by name is an error there.
mirror_asked=""

image_flag() {
    [[ -n "$1" ]] || die "--image needs an image name"
    IMAGE="$1"
    [[ "$IMAGE" == *[:/]* ]] || IMAGE="dev-agent:$IMAGE"
}

# Reads the leading wrapper options out of "$@" and reports in
# 'flags_consumed' how many of them the caller should shift away.
take_flags() {
    flags_consumed=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ro)        ro=1 ;;
            --mirror)    mirror=1; mirror_asked=1 ;;
            --workspace) mirror=""; mirror_asked="" ;;
            --host-network) host_net=1 ;;
            --proxy)     proxy=1 ;;
            --image)
                image_flag "${2:-}"
                shift
                flags_consumed=$((flags_consumed + 1))
                ;;
            --image=*)   image_flag "${1#--image=}" ;;
            *)           return ;;
        esac

        shift
        flags_consumed=$((flags_consumed + 1))
    done
}

take_flags "$@"
shift "$flags_consumed"

case "${1:-}" in
    codex|claude|bash|tmux)
        agent="$1"
        shift
        ;;
    -h|--help)
        usage
        ;;
    ""|*)
        # No command given: default to bash, leave the rest of the
        # arguments alone so a bare directory still works.
        case "${1:-}" in
            -*) die "unknown option: $1" ;;
        esac
        [[ $# -eq 0 || -d "${1:-}" ]] ||
            die "agent must be 'codex', 'claude', 'bash' or 'tmux'"
        agent="bash"
        ;;
esac

take_flags "$@"
shift "$flags_consumed"

# The proxy is reached as 'dev-agent-proxy' on a network made for this
# container, and --host-network skips that network, so the pair would leave
# every request pointed at a name that does not resolve.
[[ -n "$proxy" && -n "$host_net" ]] &&
    die "--proxy and --host-network cannot be combined"

# The hostname mirrors the image, so the shell prompt names the variant you are
# in. A hostname may only hold alphanumerics and hyphens, so the ':' of the tag
# and any registry slashes and dots collapse to '-': dev-agent:php becomes
# dev-agent-php, and the 63-character limit is enforced.
hostname="${IMAGE//[^[:alnum:]-]/-}"
hostname="${hostname:0:63}"
while [[ "$hostname" == -* ]]; do hostname="${hostname#-}"; done
while [[ "$hostname" == *- ]]; do hostname="${hostname%-}"; done
hostname="${hostname:-dev-agent}"

# First argument is a directory if supplied.
if [[ $# -gt 0 && -d "$1" ]]; then
    project="$1"
    shift
else
    project="."
fi

project="$(realpath -e "$project")"

[[ -d "$project" ]] || die "not a directory: $project"

#
# Prevent especially nasty accidental mounts.
#
case "$project" in
    /)
        die "refusing to mount /"
        ;;
    "$HOME")
        die "refusing to mount your entire home directory"
        ;;
    /home)
        die "refusing to mount /home"
        ;;
    /root)
        die "refusing to mount /root"
        ;;
esac

#
# Where the project appears inside the container.
#
# By default it is the path the project already has out here, so a file the
# agent names, a frame in a stack trace or a link inside a worktree all point
# at something that exists on both sides. /workspace, the older behaviour,
# exists on no host, and every path coming out of the container then has to be
# translated before it means anything.
#
# The price of mirroring is that the container learns your directory layout,
# and that the agents key their per-project state by working directory, so a
# project moved between the two modes starts that state afresh.
#
container_home="/home/agent"

refuse_mirror() {
    # Asked for by name, this is an error; merely inherited, /workspace is a
    # perfectly good answer and the run carries on there.
    if [[ -n "$mirror_asked" ]]; then
        die "cannot mirror $project: $1; use --workspace"
    fi

    printf 'dev-agent: mounting %s at /workspace: %s\n' "$project" "$1" >&2
    mirror=""
}

if [[ -n "$mirror" ]]; then
    case "$project" in
        # A mirrored path under the container's own home would nest inside the
        # persistent home mount, and the two would fight over one directory.
        "$container_home"|"$container_home"/*)
            refuse_mirror "it would sit inside the container's home ($container_home)"
            ;;
        # Landing on one of the image's own top-level directories would hide
        # the system that lives there.
        /bin|/boot|/dev|/etc|/lib|/lib64|/opt|/proc|/run|/sbin|/srv|/sys|/tmp|/usr|/var)
            refuse_mirror "it would hide the container's own $project"
            ;;
    esac
fi

if [[ -n "$mirror" ]]; then
    mountpoint="$project"
else
    mountpoint="/workspace"
fi

# 'docker --mount' takes comma-separated key=value pairs, so a comma anywhere
# in a path would be read as the start of another key.
case "$project" in
    *,*) die "path contains a comma, which docker --mount cannot express: $project" ;;
esac

#
# Git worktrees made inside the container record their link paths relative to
# the checkout, so they resolve both at /workspace and wherever the project
# lives on this host. Only git 2.48 and newer understands those relative
# paths: an older git here still reads and writes such a worktree, but calls
# it prunable, and `git gc` then drops its registration.
#
# None of that applies while the project is mirrored: the two sides agree on
# the path already, so even an absolute link resolves on both, and the version
# out here does not matter.
#
if [[ -z "$mirror" && -z "${DEV_AGENT_SKIP_GIT_CHECK:-}" ]] &&
   command -v git >/dev/null 2>&1; then
    host_git="$(git --version | awk '{print $3}')"

    if [[ -n "$host_git" ]] &&
       [[ "$(printf '%s\n2.48\n' "$host_git" | sort -V | head -n1)" != "2.48" ]]; then
        cat >&2 <<EOF
dev-agent: this host has git $host_git; worktrees created in the container
           need git 2.48 or newer to be seen as valid here. Until you upgrade,
           do not run 'git gc' or 'git worktree prune' in such a project.
           Set DEV_AGENT_SKIP_GIT_CHECK=1 to silence this.
EOF
    fi
fi

#
# Persistent HOME, kept on the host so it can be backed up and inspected.
#
# Shared by every command, so logins and toolchain caches are visible
# whichever one you start.
#
agent_home="${DEV_AGENT_HOME:-$HOME/.local/share/dev-agent/home}"
mkdir -p "$agent_home"
chmod 700 "$agent_home"

#
# Daily image rebuild, in the background, on the first run of the day.
#
# Does nothing until 'make autobuild-schedule' has installed the user service;
# the stamp is touched either way, so a host without it is not asked once per
# run. The stamp is also touched before the build rather than after it, so a
# build that fails waits for tomorrow instead of retrying on every run - the
# journal of the unit says why.
#
autobuild_stamp="${XDG_STATE_HOME:-$HOME/.local/state}/dev-agent/autobuild"
if [[ -z "${DEV_AGENT_NO_AUTOBUILD:-}" &&
      -z "$(find "$autobuild_stamp" -newermt today 2>/dev/null)" ]]; then
    mkdir -p "$(dirname "$autobuild_stamp")"
    touch "$autobuild_stamp"
    systemctl --user start --no-block dev-agent-autobuild.service 2>/dev/null || true
fi

#
# Egress proxy.
#
# The container is attached to a docker network created with 'internal: true',
# which has no gateway, so there is no route to the internet and no external
# name resolves. The proxy sits on that network and on a second one that does
# have a route, and is the only way out.
#
# The HTTP_PROXY and HTTPS_PROXY variables below are a convenience for
# well-behaved clients, not the enforcement. An agent that unsets them loses
# the network rather than freeing it, which is what makes the failure mode
# closed.
#
proxy_args=()

# Replaces a marked block in a file, or appends one, leaving everything else
# alone: AGENTS.md is a file the user may have their own content in. Same
# convention as the 'aliases' target in the Makefile.
write_marked_block() {
    local file="$1" begin="$2" end="$3" body="$4" tmp="$1.dev-agent.tmp"

    mkdir -p "$(dirname "$file")"
    touch "$file"

    awk -v b="$begin" -v e="$end" \
        'index($0, b) { skip = 1 } !skip { print } index($0, e) { skip = 0 }' \
        "$file" > "$tmp"

    { printf '%s\n' "$begin"; cat "$body"; printf '%s\n' "$end"; } >> "$tmp"
    mv "$tmp" "$file"
}

if [[ -n "$proxy" ]]; then
    # The host network namespace has direct internet access by definition, so
    # the combination is a contradiction rather than a layering.
    if [[ -n "$host_net" ]]; then
        die "--proxy and --host-network are mutually exclusive: the host network has
             direct internet access. Log in once with --host-network, then use --proxy."
    fi

    proxy_state="${DEV_AGENT_PROXY_STATE:-$HOME/.local/share/dev-agent/proxy}"
    proxy_compose="${DEV_AGENT_COMPOSE:-$HOME/.config/dev-agent/compose.proxy.yml}"

    [[ -f "$proxy_compose" ]] ||
        die "no proxy compose file at $proxy_compose; run 'make -C proxy install'"

    # Idempotent and fast when the proxy is already up. Failure is fatal:
    # --proxy that silently degraded to unfiltered access would be worse than
    # --proxy that refuses to start.
    docker compose -p dev-agent -f "$proxy_compose" up -d ||
        die "could not start the proxy; refusing to run without it"

    # First run only: the proxy generates the CA as it starts, which takes
    # about two seconds. Polled tenth of a second rather than by the second so
    # that a cold start is not rounded up to the next whole one; same 30s
    # budget, 300 turns of it.
    for _ in $(seq 300); do
        [[ -f "$proxy_state/agent-ca/ca.crt" ]] && break
        sleep 0.1
    done

    [[ -f "$proxy_state/agent-ca/ca.crt" ]] ||
        die "the proxy did not produce $proxy_state/agent-ca/ca.crt"

    #
    # What gets mounted is assembled here rather than in the proxy's state
    # directory, and is owned by whoever runs dev-agent.
    #
    # The proxy writes /state as its own uid and the container runs as this
    # one, so a bundle written into the proxy's state directory would be a
    # bundle this script may not have permission to write. Reading the
    # certificate out and building the bundle next door needs no such
    # agreement between the two uids.
    #
    ca_dir="${DEV_AGENT_CA:-$HOME/.local/share/dev-agent/ca}"
    mkdir -p "$ca_dir"

    cp "$proxy_state/agent-ca/ca.crt" "$ca_dir/ca.crt"

    # The trust store of *this* image with the interception CA appended, not
    # the CA alone: SSL_CERT_FILE and its siblings replace the trust store
    # rather than adding to it, so a lone certificate would break every host
    # the proxy tunnels instead of intercepting.
    #
    # Rebuilt every run. $IMAGE varies through DEV_AGENT_IMAGE, the command
    # costs a fraction of a second, and a stale trust store surfaces days
    # later as one host mysteriously failing to verify.
    if ! { docker run --rm "$IMAGE" cat /etc/ssl/certs/ca-certificates.crt &&
           cat "$ca_dir/ca.crt"; } > "$ca_dir/bundle.crt.$$"; then
        rm -f "$ca_dir/bundle.crt.$$"
        die "could not build the CA bundle from $IMAGE"
    fi

    mv "$ca_dir/bundle.crt.$$" "$ca_dir/bundle.crt"
    chmod 0644 "$ca_dir/ca.crt" "$ca_dir/bundle.crt"

    proxy_args=(
        --mount "type=bind,src=${ca_dir},dst=/etc/dev-agent-ca,readonly"

        --env "HTTP_PROXY=http://dev-agent-proxy:3128"
        --env "HTTPS_PROXY=http://dev-agent-proxy:3128"
        --env "http_proxy=http://dev-agent-proxy:3128"
        --env "https_proxy=http://dev-agent-proxy:3128"
        --env "NO_PROXY=localhost,127.0.0.1,dev-agent-proxy"
        --env "no_proxy=localhost,127.0.0.1,dev-agent-proxy"

        # The entrypoint posts here every few seconds so the UI can list this
        # container for as long as it is up, rather than only while it is
        # fetching something. The read-only listener, which is the only one an
        # agent network can reach, and no_proxy covers the hostname.
        --env "DEV_AGENT_HEARTBEAT=http://dev-agent-proxy:8098/api/heartbeat"

        # The interception CA cannot be installed into the system trust store
        # and 'update-ca-certificates' run, because the root filesystem is
        # read-only. These are the only mechanism available.
        --env SSL_CERT_FILE=/etc/dev-agent-ca/bundle.crt
        --env REQUESTS_CA_BUNDLE=/etc/dev-agent-ca/bundle.crt
        --env CURL_CA_BUNDLE=/etc/dev-agent-ca/bundle.crt
        --env GIT_SSL_CAINFO=/etc/dev-agent-ca/bundle.crt
        --env CARGO_HTTP_CAINFO=/etc/dev-agent-ca/bundle.crt
        --env PIP_CERT=/etc/dev-agent-ca/bundle.crt

        # Node appends this one, so it takes the bare certificate.
        --env NODE_EXTRA_CA_CERTS=/etc/dev-agent-ca/ca.crt

        # Node reads neither HTTP_PROXY nor HTTPS_PROXY on its own, in fetch
        # or in the core http/https modules. Without this it connects direct,
        # and since no external name resolves on this network it fails with
        # 'getaddrinfo EAI_AGAIN' - which names DNS and points at nothing that
        # is actually wrong. Needs node 24 or newer.
        --env NODE_OPTIONS=--use-env-proxy
    )

    #
    # Tell whatever is inside the container that egress is filtered, so that a
    # blocked fetch reads as policy rather than as a bug. Per agent, because
    # the mechanisms are not shared: claude has skills, codex has AGENTS.md,
    # and curl has neither. The proxy's 403 body is what always works; this is
    # only so the agent knows before it wastes a turn.
    #
    skill="${DEV_AGENT_SKILL:-$HOME/.config/dev-agent/skills/egress-policy/SKILL.md}"

    if [[ -f "$skill" ]]; then
        case "$agent" in
            claude)
                mkdir -p "$agent_home/.claude/skills/egress-policy"
                cp "$skill" "$agent_home/.claude/skills/egress-policy/SKILL.md"
                ;;
            codex)
                write_marked_block "$agent_home/.codex/AGENTS.md" \
                    '# >>> dev-agent egress policy >>>' \
                    '# <<< dev-agent egress policy <<<' \
                    "$skill"
                ;;
        esac
    else
        printf 'dev-agent: no egress skill at %s; the agent will learn from the 403 body\n' \
            "$skill" >&2
    fi

    printf 'dev-agent: egress goes through the proxy; UI at http://127.0.0.1:8099\n' >&2
fi

#
# Optional extra mounts, from a config file of the form:
#
#   mounts:
#     - ~/.gitconfig:/home/agent/.gitconfig:ro
#     - /data:/data
#
extra_mounts=()

if [[ -f "$config" ]]; then
    while IFS= read -r entry; do
        IFS=: read -r src dst opt <<<"$entry"

        [[ -n "$src" && -n "$dst" ]] ||
            die "$config: mount must be src:dst[:ro], got: $entry"

        src="${src/#\~/$HOME}"
        src="$(realpath -e "$src" 2>/dev/null)" ||
            die "$config: mount source does not exist: $entry"

        case "$opt" in
            "")   extra_mounts+=(--mount "type=bind,src=${src},dst=${dst}") ;;
            ro)   extra_mounts+=(--mount "type=bind,src=${src},dst=${dst},readonly") ;;
            *)    die "$config: unknown mount option '$opt' in: $entry" ;;
        esac
    done < <(awk '
        /^mounts:/                  { in_mounts = 1; next }
        in_mounts && /^[^[:space:]]/ { in_mounts = 0 }
        in_mounts && /^[[:space:]]*-[[:space:]]/ {
            sub(/^[[:space:]]*-[[:space:]]*/, "")
            sub(/[[:space:]]+#.*$/, "")
            gsub(/^["'"'"']|["'"'"']$/, "")
            if ($0 != "") print
        }
    ' "$config")
fi

container_name="dev-agent-${agent}-$$"

workspace_mount="type=bind,src=${project},dst=${mountpoint}"

if [[ -n "$ro" ]]; then
    workspace_mount+=",readonly"
fi

docker_args=(
    run
    --rm
    --interactive
    --tty

    --user "$(id -u):$(id -g)"

    --name "$container_name"

    # Root filesystem cannot be modified.
    --read-only

    # Don't give the process Linux capabilities.
    --cap-drop=ALL

    # Prevent gaining privileges via setuid/etc.
    --security-opt=no-new-privileges:true

    # Basic resource / fork-bomb protection.
    --pids-limit=2048

    # Scratch areas required by normal Unix tooling.
    --tmpfs /tmp:rw,nosuid,nodev,size=2g
    --tmpfs /run:rw,nosuid,nodev,size=64m

    # The project directory the agent works in, at its host path unless
    # --workspace says otherwise, and read-only under --ro.
    --mount "$workspace_mount"

    # Shared persistent auth/config, stored on the host.
    --mount "type=bind,src=${agent_home},dst=/home/agent"

    --workdir "$mountpoint"

    # Only explicitly selected environment values.
    --env HOME=/home/agent
    --env "TERM=${TERM:-xterm-256color}"

    # The container's own name, which is also what the proxy's log and UI
    # call it. Nothing inside can work it out alone: off the proxy's network
    # there is no reverse lookup that answers, and under --host-network the
    # container has no address of its own to look up.
    --env "DEV_AGENT_NAME=${container_name}"

)

# docker refuses --hostname together with --network host: the namespace it
# joins already has one.
if [[ -n "$host_net" ]]; then
    docker_args+=(--network host)
else
    docker_args+=(--hostname "$hostname")

    #
    # One internal network per container, in place of the default bridge, with
    # the proxy attached to it.
    #
    # Not the single 'agents' network compose creates: a docker bridge has
    # container-to-container traffic enabled by default, so two agents sharing
    # one can reach each other by IP and by container name. 'internal: true'
    # only removes the route out - it does not isolate the members from one
    # another. Turning that off with enable_icc=false is not the fix either,
    # because it drops agent-to-proxy traffic along with agent-to-agent, and
    # the proxy is the only thing on the network worth reaching.
    #
    # A network per container leaves the proxy as the only reachable host and
    # costs nothing else: the proxy's name resolves on every network it joins,
    # and the reverse lookup that names the client in the log still answers
    # '<container>.<network>' from the proxy's side.
    #
    # --hostname is still passed, as it is on the default bridge today.
    if [[ -n "$proxy" ]]; then
        agent_net="${container_name}-net"

        # A run killed hard leaves its network behind, and PIDs are reused.
        # --force is a no-op when there is nothing there.
        docker network rm --force "$agent_net" >/dev/null 2>&1

        docker network create --internal "$agent_net" >/dev/null ||
            die "could not create the agent network $agent_net"

        # Removed on the way out rather than left for the next run to reap,
        # so that 'docker network ls' is not a list of dead sessions.
        trap 'docker network disconnect "$agent_net" dev-agent-proxy >/dev/null 2>&1
              docker network rm --force "$agent_net" >/dev/null 2>&1' EXIT

        docker network connect "$agent_net" dev-agent-proxy ||
            die "could not attach the proxy to $agent_net"

        docker_args+=(--network "$agent_net")
    fi
fi

docker_args+=("${proxy_args[@]}")
docker_args+=("${extra_mounts[@]}")
docker_args+=("$IMAGE" "$agent" "$@")

# Not exec'd: the EXIT trap that removes the agent network has to outlive
# docker run. The exit status is docker's either way.
docker "${docker_args[@]}"
